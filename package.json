{
  "name": "migway-templates",
  "version": "0.1.0",
  "private": true,
  "description": "Migway Gmail templates: Workspace add-on and Apps Script web app",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "scopes:check": "node scripts/check-scopes.mjs",
    "deploy": "node scripts/deploy.mjs",
    "rollback": "node scripts/rollback.mjs",
    "setup:check": "node scripts/setup-check.mjs"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@types/google-apps-script": "2.0.15",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
