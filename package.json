{
  "name": "migway-templates",
  "version": "0.1.0",
  "private": true,
  "description": "Migway Gmail templates: Workspace add-on and Apps Script web app",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "scopes:check": "node scripts/check-scopes.mjs",
    "deploy": "node scripts/deploy.mjs",
    "rollback": "node scripts/rollback.mjs",
    "setup:check": "node scripts/setup-check.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@types/google-apps-script": "2.0.15",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "htmlparser2": "12.0.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.13",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.9"
  }
}
